{
    "battery": {
        "interval": 10,
        "states": {
            "warning": 30,
            "critical": 15
        },
       	"on-click": "~/.config/waybar/scripts/wofi_power.sh", 
        "format": "{icon} {capacity}%",
        "format-charging": " {capacity}%",
        "format-plugged": " {capacity}%",
        "format-icons": ["", "", "", "", ""]
    }
}
